# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26.0

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
RUN apk add --no-cache build-base ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/mikiko-gallery-studio-api ./cmd/api
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/mikiko-gallery-studio-db-migrate ./cmd/db-migrate
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/mikiko-gallery-studio-media-backfill ./cmd/media-backfill
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/mikiko-gallery-studio-local-bootstrap ./cmd/local-bootstrap

FROM alpine:3.22
WORKDIR /app
RUN apk add --no-cache ca-certificates su-exec tzdata && \
    addgroup -S picgallery && adduser -S -G picgallery picgallery && \
    mkdir -p /var/lib/pic-gallery/storage && \
    chown -R picgallery:picgallery /app /var/lib/pic-gallery
COPY --from=build /out/mikiko-gallery-studio-api /usr/local/bin/mikiko-gallery-studio-api
COPY --from=build /out/mikiko-gallery-studio-db-migrate /usr/local/bin/mikiko-gallery-studio-db-migrate
COPY --from=build /out/mikiko-gallery-studio-media-backfill /usr/local/bin/mikiko-gallery-studio-media-backfill
COPY --from=build /out/mikiko-gallery-studio-local-bootstrap /usr/local/bin/mikiko-gallery-studio-local-bootstrap
COPY --chmod=755 scripts/docker/local-runtime-entrypoint.sh /usr/local/bin/mikiko-gallery-studio-local-entrypoint
COPY api/openapi ./api/openapi
USER picgallery
EXPOSE 8080
VOLUME ["/var/lib/pic-gallery/storage"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/readyz >/dev/null || exit 1
ENTRYPOINT ["mikiko-gallery-studio-api"]

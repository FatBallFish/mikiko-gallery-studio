FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/pic-gallery-api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=build /out/pic-gallery-api /usr/local/bin/pic-gallery-api
COPY configs ./configs
COPY api ./api
EXPOSE 8080
ENTRYPOINT ["pic-gallery-api"]

# Generated runtime configuration. Update values through deployctl or the setup interface.
# 自动生成的运行时配置。请通过 deployctl 或初始化界面更新配置值。

# ---- schema ----
# [中文] 运行时配置 Schema 版本。升级工具使用它判断需要补充的字段。
# [English] Runtime configuration schema version. Upgrade tooling uses it to add newly introduced fields.
# Owner: deployctl; Restart required: true
# Example: 1
RUNTIME_SCHEMA_VERSION=1

# ---- deployment ----
# [中文] 应用运行方式，可选 docker 或 native。
# [English] Application runtime mode: docker or native.
# Owner: deployctl; Restart required: true
# Example: docker
DEPLOYMENT_MODE=
# [中文] 服务规格，可选 full、core 或 custom。原生部署不支持 full。
# [English] Service profile: full, core, or custom. Native deployments do not support full.
# Owner: deployctl; Restart required: true
# Example: core
DEPLOYMENT_PROFILE=
# [中文] 部署拓扑，可选 single 或 cluster；集群拓扑中的后端节点必须使用 S3 对象存储。
# [English] Deployment topology: single or cluster. Backend nodes in a cluster topology must use S3 object storage.
# Owner: deployctl; Restart required: true
# Example: single
DEPLOYMENT_TOPOLOGY=
# [中文] 当前节点角色，可选 single、control、api、worker 或 web。
# [English] Current node role: single, control, api, worker, or web.
# Owner: deployctl; Restart required: true
# Example: single
DEPLOYMENT_ROLE=
# [中文] 逗号分隔的本机模块清单，由部署工具维护。
# [English] Comma-separated module list for this host, managed by the deployment tool.
# Owner: deployctl; Restart required: true
# Example: api,worker,user-web,admin-web,docs-web,gateway
DEPLOYMENT_MODULES=

# ---- ownership ----
# [中文] PostgreSQL 是否由当前 Docker 完整部署管理。
# [English] Whether PostgreSQL is managed by this Docker full deployment.
# Owner: deployctl; Restart required: true
# Example: false
POSTGRES_MANAGED=false
# [中文] Redis 是否由当前 Docker 完整部署管理。
# [English] Whether Redis is managed by this Docker full deployment.
# Owner: deployctl; Restart required: true
# Example: false
REDIS_MANAGED=false
# [中文] 对象存储是否由当前 Docker 完整部署管理。
# [English] Whether object storage is managed by this Docker full deployment.
# Owner: deployctl; Restart required: true
# Example: false
OBJECT_STORAGE_MANAGED=false

# ---- setup ----
# [中文] 首次初始化是否已经完整提交。不得通过手工修改此值绕过初始化。
# [English] Whether first-run setup has been fully committed. Do not edit this value to bypass setup.
# Owner: application; Restart required: true
# Example: false
SETUP_COMPLETED=false
# [中文] 首次初始化访问凭证；初始化完成前可重复使用，完成后会被移除并永久失效。
# [English] First-run setup access credential; reusable until setup completes, then removed and permanently invalidated.
# Owner: deployctl; Restart required: true
# Example: <redacted>
SETUP_TOKEN=
# [中文] 初始化访问凭证的单调递增版本。重置凭证时版本加一，用于立即作废旧凭证和会话；初始化完成后保留最后版本。
# [English] Monotonically increasing setup credential version. Reset increments it to invalidate old credentials and sessions immediately; the final version is retained after setup completes.
# Owner: deployctl; Restart required: true
# Example: 1
SETUP_TOKEN_VERSION=1

# ---- managed middleware ----
# [中文] Docker 完整模式创建的 PostgreSQL 数据库名，仅由部署工具维护。
# [English] PostgreSQL database name created in Docker full mode and managed only by the deployment tool.
# Owner: deployctl; Restart required: true
# Example: app
POSTGRES_DATABASE=
# [中文] Docker 完整模式创建的 PostgreSQL 应用用户。
# [English] PostgreSQL application user created in Docker full mode.
# Owner: deployctl; Restart required: true
# Example: app
POSTGRES_USER=
# [中文] Docker 完整模式创建的 PostgreSQL 用户密码。
# [English] PostgreSQL user password created in Docker full mode.
# Owner: deployctl; Restart required: true
# Example: <redacted>
POSTGRES_PASSWORD=
# [中文] Docker 完整模式创建的 Redis 访问密码。
# [English] Redis password created in Docker full mode.
# Owner: deployctl; Restart required: true
# Example: <redacted>
REDIS_PASSWORD=
# [中文] Docker 完整模式创建的 MinIO 管理用户，仅用于资源准备。
# [English] MinIO administrative user created in Docker full mode for resource provisioning.
# Owner: deployctl; Restart required: true
# Example: minio-admin
MINIO_ROOT_USER=
# [中文] Docker 完整模式创建的 MinIO 管理密码，仅用于资源准备。
# [English] MinIO administrative password created in Docker full mode for resource provisioning.
# Owner: deployctl; Restart required: true
# Example: <redacted>
MINIO_ROOT_PASSWORD=

# ---- database ----
# [中文] PostgreSQL 连接地址。账号需要具备当前数据库的建表、索引和读写权限，URL 内密码必须进行 percent encoding。
# [English] PostgreSQL connection URL. The account must be able to create schema objects and read/write data, and URL passwords must be percent-encoded.
# Owner: setup; Restart required: true
# Example: <redacted>
DATABASE_URL=
# [中文] 数据库连接池最大打开连接数；留空使用应用默认值。
# [English] Maximum open database connections; leave empty to use the application default.
# Owner: setup; Restart required: true
# Example: 25
DATABASE_MAX_OPEN_CONNS=
# [中文] 数据库连接池最大空闲连接数；留空使用应用默认值。
# [English] Maximum idle database connections; leave empty to use the application default.
# Owner: setup; Restart required: true
# Example: 10
DATABASE_MAX_IDLE_CONNS=
# [中文] 数据库连接最大复用时间，使用 Go duration 格式。
# [English] Maximum database connection lifetime in Go duration format.
# Owner: setup; Restart required: true
# Example: 30m
DATABASE_CONN_MAX_LIFETIME=

# ---- redis ----
# [中文] Redis 连接地址，可能包含密码；所有 API 和 Worker 节点必须连接同一实例或集群。
# [English] Redis connection URL, which may contain a password. All API and Worker nodes must use the same instance or cluster.
# Owner: setup; Restart required: true
# Example: <redacted>
REDIS_URL=
# [中文] Redis 键名前缀；同一 Redis 上部署多个实例时必须保持唯一。
# [English] Redis key prefix; it must be unique when several installations share Redis.
# Owner: setup; Restart required: true
# Example: app
REDIS_KEY_PREFIX=app

# ---- storage ----
# [中文] 对象存储驱动，可选 local 或 s3；多节点部署必须使用 s3。
# [English] Object storage driver: local or s3. Multi-node deployments require s3.
# Owner: setup; Restart required: true
# Example: s3
STORAGE_DRIVER=
# [中文] 单节点 local 存储根目录，API 与 Worker 必须可访问同一路径。
# [English] Root directory for single-node local storage; API and Worker must access the same path.
# Owner: setup; Restart required: true
# Example: ./data/storage
STORAGE_LOCAL_ROOT=
# [中文] 资源公开访问基础地址；留空时由 API 按部署方式生成访问地址。
# [English] Public asset base URL; leave empty for the API to derive it from the deployment.
# Owner: setup; Restart required: true
# Example: http://127.0.0.1:8080/assets
STORAGE_PUBLIC_BASE_URL=
# [中文] local 存储目录是否在本节点 API 与 Worker 间共享。
# [English] Whether the local storage directory is shared by API and Worker on this host.
# Owner: setup; Restart required: true
# Example: true
STORAGE_SHARED_VOLUME=false
# [中文] S3 兼容服务地址。当前版本的所有 S3 部署均必须填写完整的 HTTP 或 HTTPS 地址。
# [English] S3-compatible endpoint. Every S3 deployment in the current release must provide a complete HTTP or HTTPS URL.
# Owner: setup; Restart required: true
# Example: http://127.0.0.1:9000
STORAGE_S3_ENDPOINT=
# [中文] S3 区域。服务不校验区域时也必须填写其约定值，例如 us-east-1。
# [English] S3 region. Providers that do not enforce regions still require their conventional value, such as us-east-1.
# Owner: setup; Restart required: true
# Example: us-east-1
STORAGE_S3_REGION=
# [中文] 存放任务输入和生成结果的 S3 Bucket 名称。
# [English] S3 bucket containing task inputs and generated outputs.
# Owner: setup; Restart required: true
# Example: app-assets
STORAGE_S3_BUCKET=
# [中文] S3 访问密钥 ID。
# [English] S3 access key ID.
# Owner: setup; Restart required: true
# Example: <redacted>
STORAGE_S3_ACCESS_KEY_ID=
# [中文] S3 访问密钥内容。
# [English] S3 secret access key.
# Owner: setup; Restart required: true
# Example: <redacted>
STORAGE_S3_SECRET_ACCESS_KEY=
# [中文] 是否强制使用 path-style S3 地址；MinIO 通常需要开启。
# [English] Whether to force path-style S3 addressing; MinIO commonly requires it.
# Owner: setup; Restart required: true
# Example: true
STORAGE_S3_FORCE_PATH_STYLE=false
# [中文] 当前安装在 Bucket 内使用的对象键前缀。
# [English] Object-key prefix used by this installation inside the bucket.
# Owner: setup; Restart required: true
# Example: production/assets
STORAGE_S3_PREFIX=

# ---- application secrets ----
# [中文] 签发用户和管理员访问令牌的密钥；初始化后不得替换。
# [English] Secret used to sign user and administrator access tokens; do not replace it after initialization.
# Owner: deployctl; Restart required: true
# Example: <redacted>
AUTH_ACCESS_TOKEN_SECRET=
# [中文] 加密数据库中 API Key 签名材料的密钥；丢失后已有密钥无法恢复。
# [English] Key encrypting API-key signing material in the database; losing it makes existing keys unrecoverable.
# Owner: deployctl; Restart required: true
# Example: <redacted>
API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=
# [中文] 加密支付渠道敏感配置的密钥；初始化后不得替换。
# [English] Key encrypting sensitive payment-provider configuration; do not replace it after initialization.
# Owner: deployctl; Restart required: true
# Example: <redacted>
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=
# [中文] 加密数据库中上游账号、对象存储和 SMTP 等敏感配置的共享密钥。
# [English] Shared key encrypting provider, object-storage, SMTP, and other sensitive database configuration.
# Owner: deployctl; Restart required: true
# Example: <redacted>
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=
# [中文] 签名提示词优化报价的密钥；所有 API 节点必须一致。
# [English] Key signing prompt-optimization quotes; it must be identical on every API node.
# Owner: deployctl; Restart required: true
# Example: <redacted>
PROMPT_OPTIMIZATION_QUOTE_SIGNING_KEY=

# ---- public endpoints ----
# [中文] 浏览器和 Web 节点可访问的 API 公共基础地址，可使用 HTTP、域名或 IP 加端口。
# [English] Public API base URL reachable by browsers and Web nodes; HTTP, domains, and IP-with-port are supported.
# Owner: setup; Restart required: true
# Example: http://127.0.0.1:8080
PUBLIC_API_URL=
# [中文] 允许跨域调用 API 的前端来源，多个来源使用逗号分隔；同源部署可留空。
# [English] Frontend origins allowed to call the API, comma-separated; leave empty for same-origin deployments.
# Owner: setup; Restart required: true
# Example: http://127.0.0.1:5173,http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=

# ---- ports ----
# [中文] API 在宿主机或 Gateway 后监听的端口。
# [English] Port on which the API listens on the host or behind the Gateway.
# Owner: deployctl; Restart required: true
# Example: 8080
API_PORT=8080
# [中文] 可移植 Gateway 对外监听端口；未部署 Gateway 时可留空。
# [English] Public listening port for the portable Gateway; leave empty when Gateway is not deployed.
# Owner: deployctl; Restart required: true
# Example: 80
GATEWAY_PORT=
# [中文] 用户前端模块的内部监听端口。
# [English] Internal listening port for the user frontend module.
# Owner: deployctl; Restart required: true
# Example: 5173
USER_WEB_PORT=
# [中文] 管理后台模块的内部监听端口。
# [English] Internal listening port for the admin frontend module.
# Owner: deployctl; Restart required: true
# Example: 5174
ADMIN_WEB_PORT=
# [中文] 文档前端模块的内部监听端口。
# [English] Internal listening port for the documentation frontend module.
# Owner: deployctl; Restart required: true
# Example: 5175
DOCS_WEB_PORT=
# [中文] 可选监控模块映射到宿主机的 Prometheus 监听端口；未部署监控模块时可留空。
# [English] Host port mapped to Prometheus by the optional monitoring module; leave empty when monitoring is not deployed.
# Owner: deployctl; Restart required: true
# Example: 9090
MONITORING_PORT=

# ---- release ----
# [中文] Docker 镜像仓库地址；原生部署可留空。
# [English] Docker image registry; leave empty for native deployments.
# Owner: deployctl; Restart required: true
# Example: registry.example.com/project
IMAGE_REGISTRY=
# [中文] Docker 各模块使用的不可变镜像标签。
# [English] Immutable Docker image tag used by application modules.
# Owner: deployctl; Restart required: true
# Example: v1.0.0
IMAGE_TAG=
# [中文] 原生发布包版本或本次部署选定的发行版本。
# [English] Native release bundle version or the release selected for this deployment.
# Owner: deployctl; Restart required: true
# Example: v1.0.0
RELEASE_VERSION=

# ---- identity ----
# [中文] 当前安装的稳定唯一标识，所有集群节点必须一致。
# [English] Stable unique installation identifier shared by every cluster node.
# Owner: deployctl; Restart required: true
# Example: 019d0000-0000-7000-8000-000000000000
INSTALLATION_ID=
# [中文] 当前集群节点的唯一标识；single 节点可留空。
# [English] Unique identifier of the current cluster node; single-node deployments may leave it empty.
# Owner: deployctl; Restart required: true
# Example: 019d0000-0000-7000-8000-000000000001
CLUSTER_NODE_ID=
# [中文] 节点当前配置修订号，用于检测集群配置漂移。
# [English] Current node configuration revision used to detect cluster configuration drift.
# Owner: application; Restart required: true
# Example: 1
CONFIG_REVISION=1
# [中文] 当前 API、Worker 或 Web 构建版本，用于加入和健康检查兼容性判断。
# [English] Current API, Worker, or Web build version used for enrollment and health compatibility checks.
# Owner: deployctl; Restart required: true
# Example: v1.0.0
APPLICATION_VERSION=

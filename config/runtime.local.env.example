# 本地共享开发环境的运行时配置 Schema 版本。
# Runtime schema version for the shared local development environment.
RUNTIME_SCHEMA_VERSION=1

# 本地环境使用 Docker、自定义完整模块清单和单节点角色。
# The local environment uses Docker, a custom full module set, and a single-node role.
DEPLOYMENT_MODE=docker
DEPLOYMENT_PROFILE=custom
DEPLOYMENT_TOPOLOGY=single
DEPLOYMENT_ROLE=single
DEPLOYMENT_MODULES=postgres,redis,minio,mailpit,api,worker,user-web,admin-web,docs-web,nginx

# local compose 持有中间件生命周期，但不使用生产 full profile 的密钥约束。
# Local Compose owns middleware lifecycle without using production full-profile credential rules.
POSTGRES_MANAGED=false
REDIS_MANAGED=false
OBJECT_STORAGE_MANAGED=false

# 共享开发库已初始化；此模板仅用于本地环境，不得用于生产部署。
# The shared development database is initialized; this template must never be used in production.
SETUP_COMPLETED=true
SETUP_TOKEN=
SETUP_TOKEN_VERSION=1

# API 和 Worker 连接 local compose 内的 PostgreSQL。
# API and Worker connect to PostgreSQL inside the local Compose network.
DATABASE_URL=postgres://postgres@postgres:5432/pic_gallery?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

# API 和 Worker 连接同一个本地 Redis，并使用独立键前缀。
# API and Worker share the local Redis instance and an isolated key prefix.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=pic-gallery

# 生成资产存放在 API 和 Worker 共享的命名卷中。
# Generated assets live in the named volume shared by API and Worker.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/pic-gallery/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8088/files
STORAGE_SHARED_VOLUME=true

# 这些固定值仅保护本机开发数据，生产环境必须由 deployctl 随机生成。
# These fixed values protect local development data only; production must generate random values with deployctl.
AUTH_ACCESS_TOKEN_SECRET=local-dev-secret
API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=local-dev-api-key-signing-secret-encryption-key
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=local-dev-cashier-provider-config-encryption-key
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=local-dev-secure-config-encryption-key
PROMPT_OPTIMIZATION_QUOTE_SIGNING_KEY=local-dev-prompt-optimization-quote-signing-key
CLUSTER_ENROLLMENT_SEAL_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# 浏览器通过统一 Nginx 入口访问 API；同时允许 localhost 与 127.0.0.1。
# Browsers reach the API through the shared Nginx entrypoint; both localhost aliases are allowed.
PUBLIC_API_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# 容器内部 API 端口和本地开发镜像标签。
# Internal API port and local development image tag.
API_PORT=8080
IMAGE_TAG=dev

# 固定安装标识必须与本地 install-state 和数据库迁移记录一致。
# The stable installation identity must match local install-state and the database migration record.
INSTALLATION_ID=pic-gallery-local
CLUSTER_NODE_ID=
CONFIG_REVISION=1
APPLICATION_VERSION=dev

# 以下扩展字段仅启用共享 E2E 所需的本地开发能力。
# The extension fields below enable only the local development capabilities required by shared E2E.
PIC_GALLERY_ENV=local
PIC_GALLERY_ADDR=:8080
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=2h
AUTH_FIXED_EMAIL_CODE=123456
AUTH_DEV_EMAIL_CODES=true
CASHIER_ENABLED=true
CASHIER_MOCK_ENABLED=true
CASHIER_SITE_BASE_URL=http://localhost:8088
WORKER_MAX_CONCURRENT_TASKS=4

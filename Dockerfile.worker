# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26.0

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
RUN apk add --no-cache build-base ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/pic-gallery-worker ./cmd/worker

FROM alpine:3.22
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S picgallery && adduser -S -G picgallery picgallery && \
    mkdir -p /var/lib/pic-gallery/storage && \
    chown -R picgallery:picgallery /app /var/lib/pic-gallery
COPY --from=build /out/pic-gallery-worker /usr/local/bin/pic-gallery-worker
COPY configs/config.example.yaml ./config.yaml
USER picgallery
VOLUME ["/var/lib/pic-gallery/storage"]
ENTRYPOINT ["pic-gallery-worker"]

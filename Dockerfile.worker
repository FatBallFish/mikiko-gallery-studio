# syntax=docker/dockerfile:1.7
ARG GO_VERSION=1.26.0

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
RUN apk add --no-cache build-base ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux CGO_CFLAGS="-D_LARGEFILE64_SOURCE" go build -trimpath -ldflags="-s -w" -o /out/mikiko-gallery-studio-worker ./cmd/worker

FROM alpine:3.22
ARG FFMPEG_VERSION=6.1.2-r2
WORKDIR /app
RUN apk add --no-cache ca-certificates "ffmpeg=${FFMPEG_VERSION}" su-exec tzdata && \
    addgroup -S picgallery && adduser -S -G picgallery picgallery && \
    mkdir -p /var/lib/pic-gallery/storage && \
    chown -R picgallery:picgallery /app /var/lib/pic-gallery
COPY --from=build /out/mikiko-gallery-studio-worker /usr/local/bin/mikiko-gallery-studio-worker
COPY --chmod=755 scripts/docker/local-runtime-entrypoint.sh /usr/local/bin/mikiko-gallery-studio-local-entrypoint
USER picgallery
VOLUME ["/var/lib/pic-gallery/storage"]
ENTRYPOINT ["mikiko-gallery-studio-worker"]

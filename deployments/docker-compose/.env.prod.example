COMPOSE_PROJECT_NAME=pic-gallery-prod

PIC_GALLERY_IMAGE_REGISTRY=docker.io/your-org
PIC_GALLERY_IMAGE_TAG=latest

POSTGRES_DB=pic_gallery
POSTGRES_USER=pic_gallery
POSTGRES_PASSWORD=change_me_with_openssl_rand_hex_32
NGINX_PORT=80
PROMETHEUS_PORT=9090
PIC_GALLERY_DOCS_URL=/developer-docs/

PIC_GALLERY_ENV=production
PIC_GALLERY_ADDR=:8080
PIC_GALLERY_TIMEZONE=Asia/Shanghai

DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

REDIS_KEY_PREFIX=pic-gallery

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/pic-gallery/storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_SHARED_VOLUME=true

AUTH_ACCESS_TOKEN_SECRET=change_me_with_openssl_rand_hex_32
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=2h
AUTH_ISSUER=pic-gallery
AUTH_REFRESH_COOKIE_NAME=pg_refresh_token
AUTH_ADMIN_REFRESH_COOKIE_NAME=pg_admin_refresh_token

API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=change_me_with_openssl_rand_hex_32
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=change_me_with_openssl_rand_hex_32
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=change_me_with_openssl_rand_hex_32

PIC_GALLERY_ADMIN_EMAIL=admin@example.com
PIC_GALLERY_ADMIN_PASSWORD=change_me_before_first_start
PIC_GALLERY_ADMIN_ROLE=super_admin

WORKER_MAX_CONCURRENT_TASKS=4
CORS_ALLOWED_ORIGINS=https://example.com

# Local development defaults used by make compose-up.
# Do not commit .env files.

POSTGRES_DB=pic_gallery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres@localhost:5432/pic_gallery?sslmode=disable

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

AUTH_ACCESS_TOKEN_SECRET=
API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_INSECURE_SKIP_VERIFY=false

PIC_GALLERY_ADMIN_ID=1
PIC_GALLERY_ADMIN_EMAIL=
PIC_GALLERY_ADMIN_PASSWORD=
PIC_GALLERY_ADMIN_TOKEN_SECRET=

# Pic Gallery backend runtime config
#
# Use the same values for api-server and worker instances in the same cluster,
# except APP_ADDR, which is only read by api-server.

APP_CONFIG_PATH=configs/config.example.yaml
APP_NAME=pic-gallery
APP_ENV=prod
APP_ADDR=:8080

# PostgreSQL. API and worker must point at the same database.
DATABASE_URL=postgres://pic_gallery:change-me@127.0.0.1:5432/pic_gallery?sslmode=disable

# Redis. Shared by all API and worker instances for sessions, rate limiting,
# idempotency, and hot state.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=pic-gallery

# Local shared storage mode. For cluster deployment this path must be a shared
# volume visible to every api-server and worker instance.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/pic-gallery/storage
STORAGE_PUBLIC_BASE_URL=https://pic-gallery.example.com/files
STORAGE_SHARED_VOLUME=true

# S3-compatible storage mode, such as MinIO or a BFSS/S3-compatible object store.
# Set STORAGE_DRIVER=s3 and fill all values below when using object storage.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=pic-gallery
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PREFIX=pic-gallery

# Optional BFSS aliases. These map to the S3-compatible storage settings above
# and can be used instead of STORAGE_S3_* when the DevOps platform exposes BFSS
# config with its own variable names.
BFSS_ENDPOINT=
BFSS_REGION=
BFSS_BUCKET=
BFSS_ACCESS_KEY_ID=
BFSS_SECRET_ACCESS_KEY=
BFSS_FORCE_PATH_STYLE=
BFSS_PREFIX=

# Secrets. Replace every value before production use and keep them identical
# across all api-server and worker instances.
AUTH_ACCESS_TOKEN_SECRET=change-me-access-token-secret
API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=change-me-api-key-signing-encryption-key
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=change-me-cashier-provider-config-key
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=change-me-secure-config-key

# First bootstrap admin. Used by the API bootstrap path when no admin exists.
PIC_GALLERY_ADMIN_EMAIL=admin@example.com
PIC_GALLERY_ADMIN_PASSWORD=change-me-admin-password

# Optional upstream provider credentials.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional SMTP config. Sensitive SMTP passwords can also be managed in Admin
# Security Config after HTTPS is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_INSECURE_SKIP_VERIFY=false

# Worker tuning.
WORKER_MAX_CONCURRENT_TASKS=4

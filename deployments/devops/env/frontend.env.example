# Pic Gallery frontend runtime config
#
# DevOps can source this file before running target/devops/user-web/start-user-web.sh
# or target/devops/admin-web/start-admin-web.sh. The script renders dist/env.js.

# Browser-visible API base URL. Use an empty value when API is served from the
# same origin and the gateway proxies /api, /docs, /files, and /v1.
PIC_GALLERY_API_BASE_URL=


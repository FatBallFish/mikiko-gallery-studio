# Pic Gallery runtime configuration.
# Copy to .env for local source-run deployments. Docker deployments use
# deployments/docker-compose/.env.prod.example as the compose-oriented template.

PIC_GALLERY_ENV=local
PIC_GALLERY_ADDR=:8080
PIC_GALLERY_TIMEZONE=Asia/Shanghai

DATABASE_URL=postgres://postgres@localhost:5432/pic_gallery?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=pic-gallery

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./tmp/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
STORAGE_SHARED_VOLUME=false

AUTH_ACCESS_TOKEN_SECRET=local-dev-secret
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=30m
AUTH_ISSUER=pic-gallery
AUTH_REFRESH_COOKIE_NAME=pg_refresh_token
AUTH_ADMIN_REFRESH_COOKIE_NAME=pg_admin_refresh_token
AUTH_FIXED_EMAIL_CODE=
AUTH_DEV_EMAIL_CODES=false

API_KEY_SIGNING_SECRET_ENCRYPTION_KEY=local-dev-api-key-signing-secret-encryption-key
CASHIER_PROVIDER_CONFIG_ENCRYPTION_KEY=local-dev-cashier-provider-config-encryption-key
PIC_GALLERY_SECURE_CONFIG_ENCRYPTION_KEY=local-dev-secure-config-encryption-key

PIC_GALLERY_ADMIN_EMAIL=admin@example.com
PIC_GALLERY_ADMIN_PASSWORD=change-me-before-first-start
PIC_GALLERY_ADMIN_ROLE=super_admin

WORKER_MAX_CONCURRENT_TASKS=4
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

USER_WEB_PORT=5173
ADMIN_WEB_PORT=5174
DOCS_WEB_PORT=5175
PIC_GALLERY_DOCS_URL=/developer-docs/

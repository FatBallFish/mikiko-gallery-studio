# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=22-alpine

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS build
WORKDIR /src
COPY web/admin/package.json web/admin/package-lock.json ./web/admin/
COPY web/shared ./web/shared
WORKDIR /src/web/admin
RUN npm ci
COPY web/admin .
ARG VITE_API_BASE_URL=
ARG VITE_BASE_PATH=./
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_BASE_PATH=${VITE_BASE_PATH}
RUN npm run build

FROM nginx:1.27-alpine
COPY deployments/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deployments/nginx/40-render-frontend-env.sh /docker-entrypoint.d/40-render-frontend-env.sh
COPY --from=build /src/web/admin/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

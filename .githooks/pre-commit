#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
case "$BRANCH" in
  main|master)
    echo "BLOCK: direct commit to $BRANCH is not allowed. Use a feature branch." >&2
    exit 1
    ;;
esac

staged="$(git diff --cached --name-only)"
[ -z "$staged" ] && exit 0

secret_candidates="$(
  printf '%s\n' "$staged" | awk '
    /(^|\/)\.env(\.[^\/]*)?\.example$/ { next }
    /(^|\/)\.env($|\.|\/)/ { print; next }
    {
      name=$0
      sub(/^.*\//, "", name)
      lower=tolower(name)
      if (lower ~ /id_rsa|private[._-]?key|secret|token/) print
    }
  '
)"
if [ -n "$secret_candidates" ]; then
  echo "BLOCK: staged files look like secrets or local env files" >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -E '\.go$' >/dev/null 2>&1; then
  files="$(printf '%s\n' "$staged" | grep -E '\.go$' | tr '\n' ' ')"
  unformatted="$(gofmt -l $files 2>/dev/null || true)"
  if [ -n "$unformatted" ]; then
    echo "BLOCK: Go files need gofmt:" >&2
    printf '%s\n' "$unformatted" >&2
    exit 1
  fi
fi

if printf '%s\n' "$staged" | grep -E '^(cmd/|internal/|pkg/|api/|configs/|deployments/|web/)' >/dev/null 2>&1; then
  if [ ! -f .coding-context.json ]; then
    echo "BLOCK: missing .coding-context.json. Run ./scripts/workflow/start-coding.sh --task \"...\" before coding." >&2
    exit 1
  fi
fi

exit 0
